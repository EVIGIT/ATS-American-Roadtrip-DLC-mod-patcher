{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ATSRoadTripConverter",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ATSRoadTripConverter.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build ATSRoadTripConverter (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ATSRoadTripConverter.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Hot Reload and run ATSRoadTripConverter",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/ATSRoadTripConverter.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Launch the app under dotnet watch. Supported edits Hot Reload; other changes rebuild and restart it.",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
